{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ramegvcamekfzfisczkf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cross-cultural-mission-mcp",
      "version": "0.1.0",
      "title": "Cross-Cultural Ministry"
    },
    "tools": [
      {
        "name": "list_missionaries",
        "title": "List missionaries",
        "description": "List missionaries in the Cross-Cultural Ministry directory. Optionally filter by area, province, or a name search string.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Case-insensitive name/church search.",
              "type": "string"
            },
            "area_id": {
              "description": "Filter by area id.",
              "type": "string"
            },
            "province": {
              "description": "Filter by province name.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_missionary",
        "title": "Get missionary",
        "description": "Fetch a single missionary profile by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Missionary id."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_areas",
        "title": "List areas",
        "description": "List ministry areas, optionally filtered by phase.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "phase_id": {
              "description": "Filter by phase id.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_ministry_updates",
        "title": "List ministry updates",
        "description": "List recent ministry updates, most recent first. Optionally filter by missionary.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "missionary_id": {
              "description": "Filter to a single missionary.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_prayer_requests",
        "title": "List prayer requests",
        "description": "List open prayer requests, urgent ones first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "include_answered": {
              "description": "Include answered requests (default false).",
              "type": "boolean"
            },
            "limit": {
              "description": "Max rows (default 30).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_announcements",
        "title": "List announcements",
        "description": "List published announcements and upcoming events.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max rows (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
